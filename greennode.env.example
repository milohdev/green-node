# Copia este archivo en el servidor como ~/greennode.env y rellena los valores reales.
# NUNCA commitear greennode.env con valores reales.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Base de datos (RDS)
ConnectionStrings__DefaultConnection=Host=greennode-db.cn4w2mo42pir.us-east-2.rds.amazonaws.com;Port=5432;Database=greennode_db;Username=greennode_admin;Password=CAMBIAR

# JWT
JwtSettings__Secret=CAMBIAR_MIN_32_CHARS
JwtSettings__Issuer=GreenNode
JwtSettings__Audience=GreenNodeClient
JwtSettings__ExpirationMinutes=60

# AWS — región y credenciales (GetAWSOptions usa AccessKey/SecretKey, no AccessKeyId/SecretAccessKey)
# Si el EC2 tiene IAM role asignado, las 3 líneas de credenciales no son necesarias.
AWS__Region=us-east-2
AWS__AccessKey=CAMBIAR
AWS__SecretKey=CAMBIAR

# S3 — nombres exactos que usa StorageService (AWS:EvidencesBucket / AWS:CertificatesBucket)
AWS__EvidencesBucket=greennode-evidencias
AWS__CertificatesBucket=greennode-certificados

# SES — clave exacta que usa EmailService (AWS:SesFromEmail)
AWS__SesFromEmail=greennode.notificaciones@gmail.com
